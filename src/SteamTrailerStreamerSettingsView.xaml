<UserControl x:Class="SteamTrailerStreamer.SteamTrailerStreamerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                   Text="Plays Steam trailers that use Steam's newer streaming format in Extra Metadata Loader's video player. Requires 'Stream Steam videos on demand' to be enabled in Extra Metadata Loader." />

        <CheckBox Content="Enabled" IsChecked="{Binding Settings.Enabled}" Margin="0,0,0,10" />

        <CheckBox Content="Make Steam microtrailers available to Extra Metadata Loader's switch-video button" IsChecked="{Binding Settings.ProvideMicrotrailers}" Margin="0,0,0,15" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Maximum trailer quality:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding Settings.MaxVideoHeight}" MinWidth="80">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0}p}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,10"
                   Text="Lower quality starts faster: 480p is roughly half the download of 720p." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Skip videos longer than (minutes):" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Text="{Binding Settings.MaxTrailerMinutes}" MinWidth="60" />
        </StackPanel>

        <TextBlock Text="ffmpeg path override (leave empty to use Extra Metadata Loader's ffmpeg):" Margin="0,5,0,5" />
        <TextBox Text="{Binding Settings.FfmpegPath}" Margin="0,0,0,5" />
        <TextBlock Margin="0,0,0,15" TextWrapping="Wrap">
            <Run Text="Using:" />
            <Run Text="{Binding DetectedFfmpegPath, Mode=OneWay}" />
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Temporary cache limit (MB):" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Text="{Binding Settings.CacheLimitMb}" MinWidth="80" />
            <Button Content="Clear cache" Command="{Binding ClearCacheCommand}" Margin="10,0,0,0" />
        </StackPanel>
        <CheckBox Content="Keep converted trailers between sessions (faster when revisiting games)" IsChecked="{Binding Settings.KeepCacheBetweenSessions}" Margin="0,0,0,5" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                   Text="Trailers are converted into a temporary folder that never grows past the limit. Unless kept, it is emptied when Playnite starts and closes." />
    </StackPanel>
</UserControl>
